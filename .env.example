# Copy to .env and adjust. Every value has a safe default, so this file is optional.
# Used by docker-compose.yml (repo root) and by `npm run dev` in backend/ (export the vars or use a tool like direnv).

PORT=3000
CORS_ORIGIN=*

# Product data source
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT_MS=5000
PRODUCT_CACHE_TTL_SECONDS=300
# Hand-picked "top rated" products, relative to backend/
CURATION_FILE=config/curation.json

# Email. "smtp" sends via SMTP_* (Mailpit in docker compose); "console" prints emails to the log.
EMAIL_TRANSPORT=console
SALES_INBOX=sales@example.com
EMAIL_FROM=catalogue@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Only needed for a real SMTP provider (e.g. Amazon SES SMTP credentials). Never commit real values.
SMTP_USER=
SMTP_PASS=

ENQUIRY_RATE_LIMIT_PER_MINUTE=5
